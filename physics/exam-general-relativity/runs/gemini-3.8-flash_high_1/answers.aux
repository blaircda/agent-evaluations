\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Schematic waveform of the gravitational wave strain $h(t)$ emitted during the coalescence of a binary compact system, demonstrating the three stages: (i) the \emph  {inspiral} with increasing amplitude and frequency (the chirp), (ii) the violent \emph  {merger} reaching maximum amplitude, and (iii) the exponentially damped \emph  {ringdown} of quasi-normal modes settling into a stationary Kerr black hole.}}{23}{figure.2}\protected@file@percent }
\newlabel{fig:gw_chirp}{{2}{23}{Schematic waveform of the gravitational wave strain $h(t)$ emitted during the coalescence of a binary compact system, demonstrating the three stages: (i) the \emph {inspiral} with increasing amplitude and frequency (the chirp), (ii) the violent \emph {merger} reaching maximum amplitude, and (iii) the exponentially damped \emph {ringdown} of quasi-normal modes settling into a stationary Kerr black hole}{figure.2}{}}
